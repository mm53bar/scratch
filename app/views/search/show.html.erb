<div class="mx-auto max-w-4xl px-4 py-8">
  <h1 class="text-xl font-semibold tracking-tight">Search</h1>
  <p class="mt-1 text-sm text-neutral-500">
    Full results. The search box above suggests as you type and jumps straight to a match.
  </p>

  <%= form_with url: search_path, method: :get, class: "mt-4" do |f| %>
    <%= f.search_field :q, value: @query, autofocus: true, autocomplete: "off",
          placeholder: "Artists, albums and tracks",
          class: "w-full rounded-md border border-neutral-300 px-3 py-2" %>
  <% end %>

  <%= render "results" %>
</div>
