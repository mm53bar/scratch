<% if @query.blank? %>
  <p class="mt-4 text-sm text-neutral-500">Start typing to search your collection.</p>
<% else %>
  <% if @artists.any? %>
    <h2 class="mt-6 text-sm font-medium uppercase tracking-wide text-neutral-500">Artists</h2>
    <ul class="mt-2 divide-y divide-neutral-100 border-y border-neutral-200">
      <% @artists.each do |artist| %>
        <li class="py-1.5">
          <%= link_to artist.name, artist_path(artist), class: "hover:underline" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @release_groups.any? %>
    <h2 class="mt-6 text-sm font-medium uppercase tracking-wide text-neutral-500">Albums</h2>
    <ul class="mt-2 divide-y divide-neutral-100 border-y border-neutral-200">
      <% @release_groups.each do |group| %>
        <li class="flex flex-wrap items-baseline gap-x-3 py-1.5">
          <span class="w-12 shrink-0 text-sm tabular-nums text-neutral-500"><%= year_or_dash(group.year) %></span>
          <%= link_to group.title, album_path(group), class: "hover:underline" %>
          <span class="text-sm text-neutral-500"><%= group.artist.name %></span>
          <span class="ml-auto flex gap-1">
            <% group.releases.map(&:medium).uniq.sort.each do |m| %><%= medium_badge(m) %><% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @tracks.any? %>
    <h2 class="mt-6 text-sm font-medium uppercase tracking-wide text-neutral-500">Tracks</h2>
    <ul class="mt-2 divide-y divide-neutral-100 border-y border-neutral-200">
      <% @tracks.each do |track| %>
        <li class="flex flex-wrap items-baseline gap-x-3 py-1.5 text-sm">
          <span><%= track.title %></span>
          <span class="text-neutral-500"><%= track.credited_artist %></span>
          <span class="ml-auto text-neutral-500">
            <%= link_to track.release_group.title, album_path(track.release_group),
                  class: "hover:underline" %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @artists.empty? && @release_groups.empty? && @tracks.empty? %>
    <p class="mt-4 text-sm text-neutral-500">Nothing found for “<%= @query %>”.</p>
  <% end %>
<% end %>
