<% if flash.any? %>
  <div class="mx-auto max-w-4xl px-4 pt-4 space-y-2">
    <% { notice: "success", alert: "warning" }.each do |key, variant| %>
      <% if flash[key].present? %>
        <%= render "shared/components/alert/alert", title: flash[key], variant: variant %>
      <% end %>
    <% end %>
  </div>
<% end %>
