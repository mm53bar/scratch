<header class="border-b border-neutral-200">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
    <%= link_to "scratch", root_path, class: "font-semibold tracking-tight" %>
    <nav class="flex gap-4 text-sm">
      <%= link_to "Artists", artists_path, class: "text-neutral-600 hover:text-neutral-900" %>
      <%= link_to "Albums", albums_path, class: "text-neutral-600 hover:text-neutral-900" %>
      <%= link_to "Shelf", shelf_path, class: "text-neutral-600 hover:text-neutral-900" %>
      <%= link_to "Library", scans_path, class: "text-neutral-600 hover:text-neutral-900" %>
    </nav>
    <div class="ml-auto w-full sm:w-72">
      <%= render "shared/components/autocomplete/autocomplete",
            id: "collection_search",
            placeholder: "Search your collection",
            url: search_suggestions_path,
            min_length: 2,
            delay: 200,
            max_suggestions: 12,
            no_results_text: "Nothing in your collection matches",
            loading_text: "Searching…" %>
    </div>
  </div>
</header>
