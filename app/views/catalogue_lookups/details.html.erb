<%= turbo_frame_tag params[:mbid].present? ? "pressing_#{params[:mbid]}" : "pressing" do %>
  <% if @unavailable || @candidate.nil? %>
    <p class="mt-1 text-xs text-neutral-500">Could not fetch details for this pressing.</p>
  <% elsif !@candidate.details? %>
    <p class="mt-1 text-xs text-neutral-500">
      MusicBrainz has nothing further on this pressing \u2014 no annotation, no Discogs link.
    </p>
  <% else %>
    <div class="mt-2 rounded-md bg-neutral-50 p-3 text-xs text-neutral-700">
      <% if @candidate.annotation.present? %>
        <%# Kept as written. When it quotes the runout stamps, the line breaks
            are the difference between one side and the other. %>
        <pre class="overflow-x-auto font-mono text-[11px] leading-relaxed whitespace-pre-wrap"><%= @candidate.annotation %></pre>
      <% end %>
      <% if @candidate.discogs_url.present? %>
        <p class="<%= "mt-2" if @candidate.annotation.present? %>">
          <%= link_to "Full pressing detail on Discogs \u2192", @candidate.discogs_url,
                target: "_blank", rel: "noopener noreferrer", class: "underline hover:text-neutral-900" %>
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>
