<div class="mx-auto max-w-4xl px-4 py-8">
  <h1 class="text-xl font-semibold tracking-tight">Your collection</h1>

  <% if @counts[:albums].zero? %>
    <p class="mt-3 text-sm text-neutral-600">
      Nothing catalogued yet. Run <code class="rounded bg-neutral-100 px-1">bin/rails library:scan</code>
      to read the library.
    </p>
  <% else %>
    <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded border border-neutral-200 bg-neutral-200 sm:grid-cols-4">
      <% { "Artists" => @counts[:artists], "Albums" => @counts[:albums],
           "Releases" => @counts[:releases], "Tracks" => @counts[:tracks] }.each do |label, value| %>
        <div class="bg-white px-4 py-3">
          <dt class="text-xs uppercase tracking-wide text-neutral-500"><%= label %></dt>
          <dd class="mt-1 text-lg font-medium tabular-nums"><%= number_with_delimiter(value) %></dd>
        </div>
      <% end %>
    </dl>

    <div class="mt-4 flex flex-wrap gap-2 text-sm">
      <% Release::MEDIA.each do |medium| %>
        <%= link_to albums_path(medium: medium),
              class: "flex items-center gap-2 rounded border border-neutral-200 px-2 py-1 hover:bg-neutral-50" do %>
          <%= medium_badge(medium) %>
          <span class="tabular-nums text-neutral-600"><%= @by_medium.fetch(medium, 0) %></span>
        <% end %>
      <% end %>
    </div>

    <h2 class="mt-8 text-sm font-medium uppercase tracking-wide text-neutral-500">Recently catalogued</h2>
    <ul class="mt-2 divide-y divide-neutral-100 border-y border-neutral-200">
      <% @recent.each do |group| %>
        <li class="flex flex-wrap items-baseline gap-x-3 py-1.5">
          <span class="w-12 shrink-0 text-sm tabular-nums text-neutral-500"><%= year_or_dash(group.year) %></span>
          <%= link_to group.title, album_path(group), class: "hover:underline" %>
          <span class="text-sm text-neutral-500"><%= group.artist.name %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h2 class="mt-10 text-sm font-medium uppercase tracking-wide text-neutral-500">Library</h2>
  <dl class="mt-2 divide-y divide-neutral-200 border-y border-neutral-200 text-sm">
    <div class="flex justify-between gap-4 py-2">
      <dt class="text-neutral-500">Path</dt>
      <dd class="text-right"><code><%= @library_path %></code></dd>
    </div>
    <div class="flex justify-between gap-4 py-2">
      <dt class="text-neutral-500">Readable</dt>
      <dd class="text-right">
        <%= @library_readable ? tag.span("yes", class: "text-green-700") :
              tag.span("no — check the mount and MUSIC_LIBRARY_PATH", class: "text-red-700") %>
      </dd>
    </div>
    <div class="flex justify-between gap-4 py-2">
      <dt class="text-neutral-500">Writable</dt>
      <dd class="text-right">
        <%= @library_writable ? tag.span("yes — the library should be mounted read-only", class: "text-red-700") :
              tag.span("no (read-only, as intended)", class: "text-green-700") %>
      </dd>
    </div>
  </dl>
</div>
