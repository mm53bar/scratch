<div class="mx-auto max-w-4xl px-4 py-8">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h1 class="text-xl font-semibold tracking-tight">Your shelf</h1>
    <%= link_to "Add a record or CD", new_release_path,
          class: "rounded-md bg-neutral-900 px-3 py-2 text-sm font-medium text-white hover:bg-neutral-800" %>
  </div>

  <% if @physical.empty? %>
    <p class="mt-4 text-sm text-neutral-600">
      Nothing on the shelf yet. Physical media is the only thing here a library scan cannot find
      for you — a record leaves no file behind.
    </p>
  <% else %>
    <p class="mt-1 text-sm text-neutral-500"><%= pluralize(@physical.size, "album") %> owned physically</p>
    <ul class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200">
      <% @physical.each do |group| %>
        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2">
          <span class="w-12 shrink-0 text-sm tabular-nums text-neutral-500"><%= year_or_dash(group.year) %></span>
          <%= link_to group.title, album_path(group), class: "hover:underline" %>
          <span class="text-sm text-neutral-500"><%= group.artist.name %></span>
          <span class="ml-auto flex items-center gap-1">
            <% group.releases.sort_by(&:medium).each do |release| %>
              <% if release.physical? %>
                <%= link_to edit_release_path(release), class: "hover:opacity-70" do %><%= medium_badge(release.medium) %><% end %>
              <% else %>
                <%= medium_badge(release.medium) %>
              <% end %>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <section class="mt-12">
    <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
      On vinyl, not digitally
    </h2>
    <p class="mt-1 text-sm text-neutral-500">
      Records you have never ripped or bought a copy of.
    </p>
    <% if @missing_digitally.empty? %>
      <p class="mt-3 text-sm text-neutral-500">None — everything on vinyl is also on disk.</p>
    <% else %>
      <ul class="mt-3 divide-y divide-neutral-100 border-y border-neutral-200">
        <% @missing_digitally.each do |group| %>
          <li class="flex flex-wrap items-baseline gap-x-3 py-1.5">
            <span class="w-12 shrink-0 text-sm tabular-nums text-neutral-500"><%= year_or_dash(group.year) %></span>
            <%= link_to group.title, album_path(group), class: "hover:underline" %>
            <span class="text-sm text-neutral-500"><%= group.artist.name %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="mt-10">
    <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">
      Digital only
    </h2>
    <p class="mt-1 text-sm text-neutral-500">
      <%= pluralize(@missing_physically.size, "album") %> with no record or CD on the shelf.
    </p>
    <% if @missing_physically.any? %>
      <ul class="mt-3 divide-y divide-neutral-100 border-y border-neutral-200">
        <% @missing_physically.first(50).each do |group| %>
          <li class="flex flex-wrap items-baseline gap-x-3 py-1.5">
            <span class="w-12 shrink-0 text-sm tabular-nums text-neutral-500"><%= year_or_dash(group.year) %></span>
            <%= link_to group.title, album_path(group), class: "hover:underline" %>
            <span class="text-sm text-neutral-500"><%= group.artist.name %></span>
            <%= link_to "add", new_release_path(release_group_id: group.id),
                  class: "ml-auto text-sm text-neutral-500 hover:underline" %>
          </li>
        <% end %>
      </ul>
      <% if @missing_physically.size > 50 %>
        <p class="mt-2 text-sm text-neutral-500">
          Showing 50 of <%= @missing_physically.size %>.
        </p>
      <% end %>
    <% end %>
  </section>
</div>
