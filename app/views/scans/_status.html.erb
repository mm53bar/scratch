<%= turbo_frame_tag "scan_status" do %>
  <% if current %>
    <%# The controller lives inside the frame, not on it: when the scan
        finishes this branch is gone, the controller disconnects, and the
        polling stops without anything having to remember to stop it. %>
    <div data-controller="poll" data-poll-interval-value="2000"
         class="rounded-md border border-neutral-200 bg-neutral-50 p-4">
      <div class="flex flex-wrap items-baseline gap-x-3">
        <span class="font-medium">Scanning…</span>
        <span class="text-sm text-neutral-500">
          <% if current.albums_total.to_i.positive? %>
            <%= current.albums_done %> of <%= current.albums_total %> albums
          <% else %>
            finding albums
          <% end %>
        </span>
        <span class="ml-auto text-sm tabular-nums text-neutral-500"><%= current.duration %>s</span>
      </div>

      <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-neutral-200">
        <% if current.percent %>
          <div class="h-full rounded-full bg-neutral-800 transition-[width] duration-500"
               style="width: <%= current.percent %>%"></div>
        <% else %>
          <%# No denominator yet, so an indeterminate stripe rather than a bar
              sitting at zero, which reads as "stuck". %>
          <div class="h-full w-1/3 animate-pulse rounded-full bg-neutral-400"></div>
        <% end %>
      </div>

      <p class="mt-2 text-xs text-neutral-500">
        This keeps running if you close the page — it is a background job, not this browser tab.
      </p>
    </div>
  <% elsif last.nil? %>
    <p class="text-sm text-neutral-600">
      The library has never been scanned from here. Scanning reads the tags on every file and
      rebuilds the digital half of the catalogue. Nothing is written to your music.
    </p>
  <% else %>
    <%= render "scans/outcome", run: last %>
  <% end %>
<% end %>
