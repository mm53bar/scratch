<div class="rounded-md border p-4 <%= run.failed? ? "border-red-200 bg-red-50" : "border-neutral-200" %>">
  <div class="flex flex-wrap items-baseline gap-x-3">
    <span class="font-medium"><%= run.failed? ? "Last scan failed" : "Last scan" %></span>
    <span class="text-sm text-neutral-500"><%= time_ago_in_words(run.started_at) %> ago</span>
    <span class="ml-auto text-sm tabular-nums text-neutral-500"><%= run.duration %>s</span>
  </div>

  <% if run.failed? %>
    <p class="mt-1 text-sm text-red-800"><%= run.error %></p>
  <% else %>
    <p class="mt-1 text-sm text-neutral-700"><%= run.summary %></p>
  <% end %>

  <% if run.skipped.any? %>
    <%# Worth surfacing rather than counting: a skipped folder is one whose
        tags could not be read, which is a fixable problem in the files. %>
    <details class="mt-2">
      <summary class="cursor-pointer text-sm text-neutral-600 hover:text-neutral-900">
        <%= pluralize(run.skipped.size, "folder") %> skipped — no readable tags
      </summary>
      <ul class="mt-1 space-y-0.5 font-mono text-xs text-neutral-600">
        <% run.skipped.first(50).each do |dir| %>
          <li><%= dir %></li>
        <% end %>
        <% if run.skipped.size > 50 %>
          <li class="text-neutral-400">… and <%= run.skipped.size - 50 %> more</li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
