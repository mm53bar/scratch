<div class="mx-auto max-w-4xl px-4 py-8">
  <h1 class="text-xl font-semibold tracking-tight">Add to your shelf</h1>
  <p class="mt-1 text-sm text-neutral-500">
    Records and CDs are entered by hand — they leave no file behind for a scan to find.
  </p>

  <% if @release.release_group_id.blank? %>
    <div class="mt-6 rounded-md border border-neutral-200 bg-neutral-50 p-4">
      <%# A separate form, not a field inside the one below: forms cannot nest,
          and this one asks a question rather than saving anything. %>
      <%= form_with url: catalogue_lookup_path, method: :get,
            data: { turbo_frame: "catalogue_results" }, class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="grow">
          <%= f.label :catalogue_number, "Catalogue number", class: "block text-sm font-medium" %>
          <%= f.text_field :catalogue_number, value: params[:catalogue_number],
                autocomplete: "off", autocapitalize: "characters", placeholder: "T-2576",
                class: "form-control mt-1 w-full" %>
        </div>
        <%= f.hidden_field :medium, value: @release.medium %>
        <%= render "shared/components/buttons/button", text: "Look it up", type: "submit", variant: "secondary" %>
      <% end %>
      <p class="mt-2 text-xs text-neutral-500">
        Printed on the label and usually on the spine. Spacing and hyphens do not matter.
        Everything below can be filled in by hand instead.
      </p>
    </div>

    <div class="mt-2"><%= turbo_frame_tag "catalogue_results" %></div>
  <% end %>

  <div class="mt-6"><%= render "form" %></div>
</div>
