<div class="mx-auto max-w-4xl px-4 py-8">
  <p class="text-sm text-neutral-500">
    <%= link_to @release.release_group.title, album_path(@release.release_group), class: "hover:underline" %>
  </p>
  <h1 class="mt-1 text-xl font-semibold tracking-tight">Edit <%= @release.medium %></h1>
  <div class="mt-6"><%= render "form" %></div>

  <div class="mt-10 border-t border-neutral-200 pt-4">
    <%= button_to "Remove from shelf", release_path(@release), method: :delete,
          form: { data: { turbo_confirm: "Remove this #{@release.medium} from your shelf?" } },
          class: "text-sm text-red-700 hover:underline" %>
  </div>
</div>
