<div class="mx-auto max-w-4xl px-4 py-8">
  <h1 class="text-xl font-semibold tracking-tight">Albums</h1>

  <div class="mt-3 flex flex-wrap gap-2 text-sm">
    <%= link_to "All", albums_path,
          class: "rounded px-2 py-1 #{@medium.blank? ? 'bg-neutral-900 text-white' : 'text-neutral-600 hover:bg-neutral-100'}" %>
    <% Release::MEDIA.each do |medium| %>
      <%= link_to medium.capitalize, albums_path(medium: medium),
            class: "rounded px-2 py-1 #{@medium == medium ? 'bg-neutral-900 text-white' : 'text-neutral-600 hover:bg-neutral-100'}" %>
    <% end %>
  </div>

  <p class="mt-3 text-sm text-neutral-500"><%= pluralize(@release_groups.size, "album") %></p>

  <ul class="mt-4 divide-y divide-neutral-200 border-y border-neutral-200">
    <% @release_groups.each do |group| %>
      <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2">
        <span class="w-12 shrink-0 text-sm tabular-nums text-neutral-500"><%= year_or_dash(group.year) %></span>
        <%= link_to group.title, album_path(group), class: "hover:underline" %>
        <span class="text-sm text-neutral-500"><%= link_to group.artist.name, artist_path(group.artist), class: "hover:underline" %></span>
        <span class="ml-auto flex gap-1">
          <% group.releases.map(&:medium).uniq.sort.each do |medium| %><%= medium_badge(medium) %><% end %>
        </span>
      </li>
    <% end %>
  </ul>
</div>
