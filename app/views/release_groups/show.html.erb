<div class="mx-auto max-w-4xl px-4 py-6 sm:py-8">
  <div class="flex items-start gap-4">
    <%= cover_image(@release_group, variant: "detail", size: 96) %>
    <div class="min-w-0">
      <p class="text-sm text-neutral-500">
        <%= link_to @release_group.artist.name, artist_path(@release_group.artist), class: "hover:underline" %>
      </p>
      <h1 class="mt-1 text-xl font-semibold tracking-tight"><%= @release_group.title %></h1>
      <p class="mt-1 text-sm text-neutral-500"><%= year_or_dash(@release_group.year) %></p>
    </div>
  </div>

  <% @releases.each do |release| %>
    <section class="mt-8">
      <div class="flex flex-wrap items-baseline gap-3 border-b border-neutral-200 pb-2">
        <%= medium_badge(release.medium) %>
        <% if release.edition.present? %>
          <span class="text-sm text-neutral-700"><%= release.edition %></span>
        <% end %>
        <span class="text-sm text-neutral-500"><%= pluralize(release.tracks.size, "track") %></span>
        <% if release.catalogue_number.present? %>
          <%# The number is how you match this entry to the object on the
              shelf, so it belongs where you are comparing the two. %>
          <span class="font-mono text-xs text-neutral-500"><%= release.catalogue_number %></span>
        <% end %>
        <% if release.country.present? %>
          <span class="text-sm text-neutral-500"><%= release.country %></span>
        <% end %>
        <% if release.acquired_on %>
          <span class="text-sm text-neutral-500">acquired <%= release.acquired_on.to_fs(:long) %></span>
        <% end %>
      </div>

      <% if release.tracks.any? %>
        <ol class="mt-2 divide-y divide-neutral-100">
          <% release.tracks.each do |track| %>
            <li class="flex items-baseline gap-3 py-1.5 text-sm">
              <span class="w-8 shrink-0 text-right tabular-nums text-neutral-400"><%= track.position %></span>
              <%# min-w-0 so a long title wraps instead of pushing the duration
                  off a phone screen — flex children default to min-width auto,
                  which stops the text breaking at all. %>
              <span class="min-w-0 flex-1">
                <%= track.title %>
                <% if track.artist_credit.present? %>
                  <span class="text-neutral-500">— <%= track.artist_credit %></span>
                <% end %>
              </span>
              <span class="shrink-0 tabular-nums text-neutral-400"><%= track.duration %></span>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-2 text-sm text-neutral-500">
          No track listing — physical media is catalogued by hand, and this one has not been filled in.
        </p>
      <% end %>
    </section>
  <% end %>
</div>
